{
  "name": "workagent-b01",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "test:sheet-scale": "node apps/workagent-client/tests/sheet-scale.mjs",
    "test": "npm run test:mechanisms && npm run test:http && npm run test:integration && npm run test:pdf",
    "typecheck": "tsc -p apps/workagent-client/tsconfig.json",
    "build": "vite build --config apps/workagent-client/vite.config.ts",
    "start": "node apps/workagent-server/src/main.mjs",
    "test:mechanisms": "node apps/workagent-server/tests/access.test.mjs && node apps/workagent-server/tests/workspace.test.mjs && node apps/workagent-server/tests/read-path.test.mjs && node apps/workagent-runner/tests/provider-contract.test.mjs && node apps/workagent-runner/tests/provider-budget.test.mjs && node apps/workagent-server/tests/event-resume.test.mjs && node apps/workagent-client/tests/resume.test.mjs && npm run test:background && npm run test:exchange && npm run test:native-context && npm run test:documents",
    "test:integration": "node apps/workagent-runner/tests/host.test.mjs && node apps/workagent-runner/tests/live-outcome.test.mjs && node apps/workagent-client/tests/native.test.mjs && npm run test:focus && npm run test:formatting && npm run test:controls && npm run test:conditional && npm run test:charts && node apps/workagent-runner/tests/dispatch-recovery.test.mjs",
    "provision": "node apps/workagent-server/src/provision.mjs",
    "test:http": "node apps/workagent-server/tests/http.test.mjs && node apps/workagent-server/tests/shutdown.test.mjs && npm run test:collaboration",
    "test:background": "node apps/workagent-server/tests/responsibilities.test.mjs && node apps/workagent-client/tests/maintenance-actions.test.mjs",
    "test:exchange": "node apps/workagent-server/tests/exchange.test.mjs && node apps/workagent-client/tests/csv-exchange.test.mjs && node apps/workagent-client/tests/artifact-storage.test.mjs && node apps/workagent-client/tests/csv-app.test.mjs && node apps/workagent-client/tests/formula-cache.test.mjs",
    "test:sheet-read": "node apps/workagent-runner/tests/sheet-read.test.mjs && node apps/workagent-runner/tests/bounded-sheet-host.test.mjs",
    "test:native-context": "npm run test:sheet-read && node apps/workagent-server/tests/native-context.test.mjs && node apps/workagent-runner/tests/native-context.test.mjs",
    "test:xlsx": ".local/xlsx-python/bin/python -I services/workagent-execution/xlsx/test_codec.py && node apps/workagent-server/tests/xlsx.test.mjs && node apps/workagent-client/tests/xlsx-exchange.test.mjs && node apps/workagent-client/tests/xlsx-native.test.mjs && node apps/workagent-client/tests/xlsx-charts.test.mjs && node apps/workagent-client/tests/xlsx-conditional.test.mjs && node apps/workagent-client/tests/xlsx-color-scales.test.mjs && node apps/workagent-client/tests/xlsx-data-bars.test.mjs && npm run test:xlsx-icons",
    "test:xlsx-icon-native": "node --test-name-pattern=icon apps/workagent-client/tests/conditional-formatting.test.mjs",
    "test:xlsx-icons": "node apps/workagent-client/tests/xlsx-icons.test.mjs && npm run test:quarter-icons",
    "test:xlsx-isolation": "node apps/workagent-server/tests/xlsx-isolation.test.mjs",
    "test:documents": "node apps/workagent-server/tests/documents.test.mjs && node apps/workagent-server/tests/document-selection.test.mjs && node apps/workagent-client/tests/document-native.test.mjs && node apps/workagent-client/tests/document-exchange.test.mjs && node apps/workagent-runner/tests/documents.test.mjs",
    "test:docx": ".local/docx-python/bin/python -I services/workagent-execution/docx/test_codec.py && node apps/workagent-server/tests/docx.test.mjs && node apps/workagent-client/tests/docx-exchange.test.mjs && node apps/workagent-client/tests/docx-native.test.mjs",
    "test:docx-isolation": "node apps/workagent-server/tests/docx-isolation.test.mjs",
    "test:pdf": "/usr/bin/python3 -I services/workagent-execution/pdf/test_render.py && /usr/bin/python3 -I services/workagent-execution/pdf/test_extract.py && /usr/bin/python3 -I services/workagent-execution/pdf/test_ocr.py && node apps/workagent-server/tests/pdf.test.mjs && node apps/workagent-client/tests/pdf-export.test.mjs && node apps/workagent-server/tests/pdf-import.test.mjs && node apps/workagent-client/tests/pdf-import.test.mjs",
    "test:pdf-isolation": "node apps/workagent-server/tests/pdf-isolation.test.mjs && node apps/workagent-server/tests/pdf-import-isolation.test.mjs && node apps/workagent-server/tests/pdf-ocr-isolation.test.mjs",
    "test:focus": "node apps/workagent-client/tests/editor-focus.test.mjs && npm run test:work-area",
    "test:work-area": "node apps/workagent-client/tests/mobile-work-area.test.mjs && node apps/workagent-client/tests/header-style.test.mjs",
    "test:charts": "node apps/workagent-server/tests/model-charts.test.mjs && node apps/workagent-runner/tests/model-charts.test.mjs && node apps/workagent-client/tests/sheet-charts.test.mjs && node apps/workagent-client/tests/chart-cell-operations.test.mjs && node apps/workagent-client/tests/chart-structure.test.mjs",
    "test:controls": "node apps/workagent-client/tests/native-controls.test.mjs && node apps/workagent-client/tests/validation-settlement.test.mjs",
    "test:conditional": "node apps/workagent-client/tests/conditional-formatting.test.mjs && node apps/workagent-client/tests/conditional-editor.test.mjs && node apps/workagent-client/tests/xlsx-conditional.test.mjs",
    "test:formatting": "node apps/workagent-client/tests/header-style.test.mjs && node apps/workagent-client/tests/native-formatting.test.mjs",
    "test:quarter-icons": "node apps/workagent-client/tests/native-quarter-icons.test.mjs && node apps/workagent-client/tests/xlsx-quarters.test.mjs",
    "test:collaboration": "node apps/workagent-server/tests/collaboration.test.mjs && node --test-name-pattern='B05' apps/workagent-client/tests/csv-app.test.mjs",
    "test:google": "node apps/workagent-server/tests/google-contract.test.mjs && node apps/workagent-server/tests/google-http.test.mjs",
    "test:google:contract": "node apps/workagent-server/tests/google-contract.test.mjs",
    "test:google:integration": "node apps/workagent-server/tests/google-exchange.test.mjs && node apps/workagent-client/tests/google-exchange.test.mjs && node apps/workagent-client/tests/mobile-work-area.test.mjs",
    "test:google:integration:http": "node apps/workagent-server/tests/google-exchange-http.test.mjs",
    "google:simulator": "node apps/workagent-server/src/google-simulation.mjs",
    "test:native-collaboration": "node apps/workagent-server/tests/native-collaboration.test.mjs && node apps/workagent-server/tests/native-qualification-storage.test.mjs && node apps/workagent-server/tests/native-workspace.test.mjs && node apps/workagent-client/tests/native-cache.test.mjs && node apps/workagent-client/tests/native-cursor-session.test.mjs && node apps/workagent-client/tests/native-presence.test.mjs && node apps/workagent-client/tests/native-follow.test.mjs && node apps/workagent-client/tests/native-facade-isolation.test.mjs && npm run test:native-comments && npm run test:native-history && npm run test:native-reversal && npm run test:native-merge",
    "native:provision": "node apps/workagent-server/src/native-qualification-provision.mjs",
    "native:qualification": "node apps/workagent-server/src/native-qualification.mjs",
    "build:native": "vite build --config apps/workagent-client/vite.native.config.ts",
    "test:native-merge": "node apps/workagent-server/tests/native-merge-sdk.test.mjs && node apps/workagent-client/tests/native-merge.test.mjs && node apps/workagent-server/tests/native-merge-pipeline.test.mjs",
    "test:native-comments": "node apps/workagent-server/tests/native-comments.test.mjs && node apps/workagent-server/tests/native-comments-pipeline.test.mjs && node apps/workagent-client/tests/native-comments.test.mjs",
    "test:native-history": "node apps/workagent-server/tests/native-history-sdk.test.mjs && node apps/workagent-server/tests/native-history.test.mjs && node apps/workagent-client/tests/native-history.test.mjs",
    "test:native-reversal": "node apps/workagent-server/tests/native-reversal.test.mjs && npm run test:native-reversal-client",
    "test:native-reversal-client": "node apps/workagent-client/tests/native-reversal.test.mjs",
    "test:native-agent": "node apps/workagent-runner/tests/native-agent.test.mjs",
    "test:native-agent-client": "node apps/workagent-client/tests/native-agent.test.mjs"
  },
  "dependencies": {
    "@univerjs/core": "1.4.0",
    "@univerjs/preset-docs-core": "1.4.0",
    "@univerjs/preset-sheets-conditional-formatting": "1.4.0",
    "@univerjs/preset-sheets-core": "1.4.0",
    "@univerjs/preset-sheets-data-validation": "1.4.0",
    "@univerjs/presets": "1.4.0",
    "pg": "8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "@univerjs-pro/collaboration-service": "1.4.0",
    "@univerjs-pro/collaboration-endpoint": "1.4.0",
    "@univerjs-pro/collaboration-transport-node": "1.4.0",
    "@univerjs-pro/collaboration-database-sqlite": "1.4.0",
    "@univerjs-pro/collaboration": "1.4.0",
    "@univerjs-pro/collaboration-client": "1.4.0",
    "@univerjs-pro/collaboration-client-ui": "1.4.0",
    "@univerjs-pro/license": "1.4.0",
    "@univerjs/protocol": "1.4.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "vite": "7.2.2"
  },
  "workspaces": [
    "apps/workagent-runner"
  ]
}
