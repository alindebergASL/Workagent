{
  "name": "workagent-b01",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "test": "npm run test:mechanisms && npm run test:http && npm run test:integration",
    "typecheck": "tsc -p apps/workagent-client/tsconfig.json",
    "build": "vite build --config apps/workagent-client/vite.config.ts",
    "start": "node apps/workagent-server/src/main.mjs",
    "test:mechanisms": "node apps/workagent-server/tests/access.test.mjs && node apps/workagent-server/tests/workspace.test.mjs && node apps/workagent-runner/tests/provider-contract.test.mjs && node apps/workagent-runner/tests/provider-budget.test.mjs && node apps/workagent-server/tests/event-resume.test.mjs && node apps/workagent-client/tests/resume.test.mjs && npm run test:background && npm run test:exchange && npm run test:native-context",
    "test:integration": "node apps/workagent-runner/tests/host.test.mjs && node apps/workagent-runner/tests/live-outcome.test.mjs && node apps/workagent-client/tests/native.test.mjs && node apps/workagent-runner/tests/dispatch-recovery.test.mjs",
    "provision": "node apps/workagent-server/src/provision.mjs",
    "test:http": "node apps/workagent-server/tests/http.test.mjs",
    "test:background": "node apps/workagent-server/tests/responsibilities.test.mjs && node apps/workagent-client/tests/maintenance-actions.test.mjs",
    "test:exchange": "node apps/workagent-server/tests/exchange.test.mjs && node apps/workagent-client/tests/csv-exchange.test.mjs && node apps/workagent-client/tests/csv-app.test.mjs && node apps/workagent-client/tests/formula-cache.test.mjs",
    "test:native-context": "node apps/workagent-server/tests/native-context.test.mjs && node apps/workagent-runner/tests/native-context.test.mjs"
  },
  "dependencies": {
    "@univerjs/presets": "1.4.0",
    "@univerjs/preset-sheets-core": "1.4.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "pg": "8.16.3",
    "@univerjs/core": "1.4.0"
  },
  "devDependencies": {
    "vite": "7.2.2",
    "typescript": "5.9.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2"
  },
  "workspaces": [
    "apps/workagent-runner"
  ]
}
