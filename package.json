{
  "name": "workagent-b01",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "test:sheet-scale": "node apps/workagent-client/tests/sheet-scale.mjs",
    "test": "npm run test:mechanisms && npm run test:http && npm run test:integration",
    "typecheck": "tsc -p apps/workagent-client/tsconfig.json",
    "build": "vite build --config apps/workagent-client/vite.config.ts",
    "start": "node apps/workagent-server/src/main.mjs",
    "test:mechanisms": "node apps/workagent-server/tests/access.test.mjs && node apps/workagent-server/tests/workspace.test.mjs && node apps/workagent-runner/tests/provider-contract.test.mjs && node apps/workagent-runner/tests/provider-budget.test.mjs && node apps/workagent-server/tests/event-resume.test.mjs && node apps/workagent-client/tests/resume.test.mjs && npm run test:background && npm run test:exchange && npm run test:native-context && npm run test:documents",
    "test:integration": "node apps/workagent-runner/tests/host.test.mjs && node apps/workagent-runner/tests/live-outcome.test.mjs && node apps/workagent-client/tests/native.test.mjs && npm run test:focus && npm run test:formatting && node apps/workagent-runner/tests/dispatch-recovery.test.mjs",
    "provision": "node apps/workagent-server/src/provision.mjs",
    "test:http": "node apps/workagent-server/tests/http.test.mjs",
    "test:background": "node apps/workagent-server/tests/responsibilities.test.mjs && node apps/workagent-client/tests/maintenance-actions.test.mjs",
    "test:exchange": "node apps/workagent-server/tests/exchange.test.mjs && node apps/workagent-client/tests/csv-exchange.test.mjs && node apps/workagent-client/tests/artifact-storage.test.mjs && node apps/workagent-client/tests/csv-app.test.mjs && node apps/workagent-client/tests/formula-cache.test.mjs",
    "test:sheet-read": "node apps/workagent-runner/tests/sheet-read.test.mjs && node apps/workagent-runner/tests/bounded-sheet-host.test.mjs",
    "test:native-context": "npm run test:sheet-read && node apps/workagent-server/tests/native-context.test.mjs && node apps/workagent-runner/tests/native-context.test.mjs",
    "test:xlsx": ".local/xlsx-python/bin/python -I services/workagent-execution/xlsx/test_codec.py && node apps/workagent-server/tests/xlsx.test.mjs && node apps/workagent-client/tests/xlsx-exchange.test.mjs && node apps/workagent-client/tests/xlsx-native.test.mjs",
    "test:xlsx-isolation": "node apps/workagent-server/tests/xlsx-isolation.test.mjs",
    "test:documents": "node apps/workagent-server/tests/documents.test.mjs && node apps/workagent-server/tests/document-selection.test.mjs && node apps/workagent-client/tests/document-native.test.mjs && node apps/workagent-client/tests/document-exchange.test.mjs && node apps/workagent-runner/tests/documents.test.mjs",
    "test:docx": ".local/docx-python/bin/python -I services/workagent-execution/docx/test_codec.py && node apps/workagent-server/tests/docx.test.mjs && node apps/workagent-client/tests/docx-exchange.test.mjs && node apps/workagent-client/tests/docx-native.test.mjs",
    "test:docx-isolation": "node apps/workagent-server/tests/docx-isolation.test.mjs",
    "test:pdf": "python3 -I services/workagent-execution/pdf/test_render.py && node apps/workagent-server/tests/pdf.test.mjs && node apps/workagent-client/tests/pdf-export.test.mjs",
    "test:pdf-isolation": "node apps/workagent-server/tests/pdf-isolation.test.mjs",
    "test:focus": "node apps/workagent-client/tests/editor-focus.test.mjs",
    "test:formatting": "node apps/workagent-client/tests/header-style.test.mjs && node apps/workagent-client/tests/native-formatting.test.mjs"
  },
  "dependencies": {
    "@univerjs/core": "1.4.0",
    "@univerjs/preset-docs-core": "1.4.0",
    "@univerjs/preset-sheets-core": "1.4.0",
    "@univerjs/presets": "1.4.0",
    "pg": "8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "vite": "7.2.2"
  },
  "workspaces": [
    "apps/workagent-runner"
  ]
}
