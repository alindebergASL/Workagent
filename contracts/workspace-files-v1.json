              "type": "null"
            }
          ],
          "default": null,
          "title": "Omitted Tables"
        },
        "paragraphs_covered": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraphs Covered"
        },
        "partial_last_block": {
          "anyOf": [
            {
              "type": "boolean"
