        "acknowledge_removed_content": {
          "default": false,
          "title": "Acknowledge Removed Content",
          "type": "boolean"
        },
        "command_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Command Id",
          "type": "string"
        },
        "expected_current_revision_id": {
          "maxLength": 128,
          "minLength": 1,
