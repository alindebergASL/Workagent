        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "const": "workagent/v1",
          "title": "Schema Version",
          "type": "string"
