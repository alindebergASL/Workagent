          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "command_id",
        "expected_current_revision_id",
        "expected_sha256"
      ],
      "title": "AcceptFileProposal",
      "type": "object"
    },
