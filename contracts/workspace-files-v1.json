        "source": {
          "discriminator": {
            "mapping": {
              "attachment": "#/$defs/AttachmentEvidence",
              "document": "#/$defs/DocumentEvidence",
              "text": "#/$defs/WorkingText"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/WorkingText"
            },
            {
              "$ref": "#/$defs/DocumentEvidence"
            },
            {
              "$ref": "#/$defs/AttachmentEvidence"
            }
          ],
          "title": "Source"
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "command_id",
        "expected_work_version",
        "source"
