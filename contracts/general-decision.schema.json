{
  "$defs": {
    "AttachmentRef": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Ref",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "sha256"
      ],
      "title": "AttachmentRef",
      "type": "object"
    },
    "CSVDecision": {
      "additionalProperties": false,
      "properties": {
        "attachment": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttachmentRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "const": "reconcile_csv",
          "title": "Kind",
          "type": "string"
        },
        "rounding": {
          "enum": [
            "ROUND_HALF_UP",
            "ROUND_HALF_EVEN"
          ],
          "title": "Rounding",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecisionTarget"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "attachment",
        "target",
        "rounding"
      ],
      "title": "CSVDecision",
      "type": "object"
    },
    "DecisionTarget": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Artifact Id",
          "type": "string"
        },
        "body_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Body Hash",
          "type": "string"
        },
        "revision_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Revision Id",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "revision_id",
        "body_hash"
      ],
      "title": "DecisionTarget",
      "type": "object"
    },
    "DraftAction": {
      "additionalProperties": false,
      "properties": {
        "binding": {
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
          "title": "Binding",
          "type": "string"
        },
        "kind": {
          "const": "read_binding",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "payload_schema": {
          "$ref": "#/$defs/DraftPayloadSchema"
        }
      },
      "required": [
        "name",
        "kind",
        "binding",
        "payload_schema"
      ],
      "title": "DraftAction",
      "type": "object"
    },
    "DraftBlock": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Block Id",
          "type": "string"
        },
        "checked": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Checked"
        },
        "kind": {
          "enum": [
            "heading",
            "paragraph",
            "checklist",
            "protected_note"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "block_id",
        "kind",
        "text",
        "checked"
      ],
      "title": "DraftBlock",
      "type": "object"
    },
    "DraftDocument": {
      "additionalProperties": false,
      "properties": {
        "blocks": {
          "items": {
            "$ref": "#/$defs/DraftBlock"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Blocks",
          "type": "array"
        },
        "title": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "blocks"
      ],
      "title": "DraftDocument",
      "type": "object"
    },
    "DraftField": {
      "additionalProperties": false,
      "properties": {
        "editable": {
          "title": "Editable",
          "type": "boolean"
        },
        "enum": {
          "anyOf": [
            {
              "items": {
                "maxLength": 120,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 30,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Enum"
        },
        "key": {
          "pattern": "^[a-z][a-z0-9_]{0,47}$",
          "title": "Key",
          "type": "string"
        },
        "label": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "scale": {
          "anyOf": [
            {
              "maximum": 6,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Scale"
        },
        "type": {
          "enum": [
            "text",
            "integer",
            "decimal",
            "boolean",
            "enum"
          ],
          "title": "Type",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        }
      },
      "required": [
        "key",
        "label",
        "type",
        "editable",
        "unit",
        "scale",
        "enum"
      ],
      "title": "DraftField",
      "type": "object"
    },
    "DraftPayloadSchema": {
      "additionalProperties": false,
      "properties": {
        "additionalProperties": {
          "const": false,
          "title": "Additionalproperties",
          "type": "boolean"
        },
        "properties": {
          "$ref": "#/$defs/EmptyPayload"
        },
        "type": {
          "const": "object",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "properties",
        "additionalProperties"
      ],
      "title": "DraftPayloadSchema",
      "type": "object"
    },
    "DraftSource": {
      "additionalProperties": false,
      "properties": {
        "css": {
          "maxLength": 48000,
          "title": "Css",
          "type": "string"
        },
        "html": {
          "maxLength": 48000,
          "minLength": 1,
          "title": "Html",
          "type": "string"
        },
        "js": {
          "maxLength": 48000,
          "title": "Js",
          "type": "string"
        }
      },
      "required": [
        "html",
        "css",
        "js"
      ],
      "title": "DraftSource",
      "type": "object"
    },
    "DraftTable": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "items": {
            "$ref": "#/$defs/DraftField"
          },
          "maxItems": 24,
          "minItems": 1,
          "title": "Fields",
          "type": "array"
        },
        "kind": {
          "const": "structured_table",
          "title": "Kind",
          "type": "string"
        },
        "notes": {
          "items": {
            "maxLength": 10000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Notes",
          "type": "array"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/TableRow"
          },
          "maxItems": 200,
          "title": "Rows",
          "type": "array"
        },
        "title": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "version": {
          "const": "structured-table/v1",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "version",
        "title",
        "fields",
        "rows",
        "notes"
      ],
      "title": "DraftTable",
      "type": "object"
    },
    "DraftView": {
      "additionalProperties": false,
      "properties": {
        "access_generation": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Access Generation",
          "type": "integer"
        },
        "actions": {
          "items": {
            "$ref": "#/$defs/DraftAction"
          },
          "maxItems": 8,
          "title": "Actions",
          "type": "array"
        },
        "bindings": {
          "items": {
            "$ref": "#/$defs/ViewBinding"
          },
          "maxItems": 4,
          "title": "Bindings",
          "type": "array"
        },
        "fallback": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Fallback",
          "type": "string"
        },
        "kind": {
          "const": "custom_view",
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/DraftSource"
        },
        "title": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "version": {
          "const": "custom-view/v1",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "version",
        "title",
        "source",
        "fallback",
        "access_generation",
        "bindings",
        "actions"
      ],
      "title": "DraftView",
      "type": "object"
    },
    "EmptyPayload": {
      "additionalProperties": false,
      "properties": {},
      "title": "EmptyPayload",
      "type": "object"
    },
    "FormField": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "label"
      ],
      "title": "FormField",
      "type": "object"
    },
    "PublishDecision": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "anyOf": [
            {
              "$ref": "#/$defs/DraftDocument"
            },
            {
              "$ref": "#/$defs/DraftTable"
            },
            {
              "$ref": "#/$defs/DraftView"
            }
          ],
          "title": "Body"
        },
        "kind": {
          "const": "publish_artifact",
          "title": "Kind",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecisionTarget"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "target",
        "body"
      ],
      "title": "PublishDecision",
      "type": "object"
    },
    "Reply": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "reply",
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "title": "Reply",
      "type": "object"
    },
    "TableCell": {
      "additionalProperties": false,
      "properties": {
        "field_key": {
          "pattern": "^[a-z][a-z0-9_]{0,47}$",
          "title": "Field Key",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "field_key",
        "value"
      ],
      "title": "TableCell",
      "type": "object"
    },
    "TableRow": {
      "additionalProperties": false,
      "properties": {
        "cells": {
          "items": {
            "$ref": "#/$defs/TableCell"
          },
          "maxItems": 24,
          "title": "Cells",
          "type": "array"
        },
        "row_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Row Id",
          "type": "string"
        }
      },
      "required": [
        "row_id",
        "cells"
      ],
      "title": "TableRow",
      "type": "object"
    },
    "ViewBinding": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Artifact Id",
          "type": "string"
        },
        "body_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Body Hash",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "revision_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Revision Id",
          "type": "string"
        }
      },
      "required": [
        "name",
        "artifact_id",
        "revision_id",
        "body_hash"
      ],
      "title": "ViewBinding",
      "type": "object"
    },
    "WasmDecision": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "items": {
            "maximum": 1000000000,
            "minimum": -1000000000,
            "type": "integer"
          },
          "maxItems": 8,
          "title": "Arguments",
          "type": "array"
        },
        "code": {
          "maxLength": 16000,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "entrypoint": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
          "title": "Entrypoint",
          "type": "string"
        },
        "input_form": {
          "items": {
            "$ref": "#/$defs/FormField"
          },
          "maxItems": 8,
          "title": "Input Form",
          "type": "array"
        },
        "kind": {
          "const": "run_wasm",
          "title": "Kind",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecisionTarget"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "target",
        "code",
        "entrypoint",
        "arguments",
        "input_form"
      ],
      "title": "WasmDecision",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "decision": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply"
        },
        {
          "$ref": "#/$defs/CSVDecision"
        },
        {
          "$ref": "#/$defs/WasmDecision"
        },
        {
          "$ref": "#/$defs/PublishDecision"
        }
      ],
      "title": "Decision"
    }
  },
  "required": [
    "decision"
  ],
  "title": "GeneralDecision",
  "type": "object"
}
