            "properties": {
              "label": {
                "maxLength": 120,
                "minLength": 1,
                "title": "Label",
                "type": "string"
              },
              "maximum": {
                "const": 1000000000,
                "default": 1000000000,
                "title": "Maximum",
                "type": "integer"
              },
              "minimum": {
                "const": -1000000000,
                "default": -1000000000,
                "title": "Minimum",
                "type": "integer"
              },
              "name": {
                "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
                "title": "Name",
                "type": "string"
              },
              "type": {
                "const": "integer",
                "default": "integer",
                "title": "Type",
                "type": "string"
              }
            },
            "required": [
              "name",
              "label"
            ],
            "title": "InputField",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "arguments": {
            "items": {
              "maximum": 1000000000,
              "minimum": -1000000000,
              "type": "integer"
            },
            "maxItems": 8,
            "title": "Arguments",
            "type": "array"
          },
          "artifact_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Artifact Id"
          },
          "base_revision_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Base Revision Id"
          },
          "code": {
            "anyOf": [
              {
                "maxLength": 16000,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Code"
          },
          "entrypoint": {
            "default": "total",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
            "title": "Entrypoint",
            "type": "string"
          },
          "input_form": {
            "items": {
              "$ref": "#/$defs/InputField"
