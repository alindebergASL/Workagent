          },
          "base_revision_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Base Revision Id"
          },
          "input_csv": {
            "anyOf": [
              {
                "maxLength": 200000,
                "minLength": 1,
                "type": "string"
