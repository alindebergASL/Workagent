        "command_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Command Id",
          "type": "string"
        },
        "conversation_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Conversation Id",
          "type": "string"
        },
        "expected_work_version": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Expected Work Version",
          "type": "integer"
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "const": "workagent/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "work_area_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Work Area Id",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "command_id",
        "conversation_id",
        "work_area_id",
        "expected_work_version"
      ],
      "title": "BindMemoryScope",
      "type": "object"
    },
    "CorrectMemory": {
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Command Id",
          "type": "string"
        },
        "content": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "expected_revision_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Expected Revision Id",
          "type": "string"
        },
        "mode": {
          "default": "permanent",
          "enum": [
            "permanent",
            "temporary"
          ],
          "title": "Mode",
          "type": "string"
        },
        "procedure": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProcedureDetails"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "const": "workagent/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "discriminator": {
              "mapping": {
                "file": "#/$defs/MemoryFile",
                "source": "#/$defs/MemorySource"
              },
              "propertyName": "source_type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/MemorySource"
              },
              {
                "$ref": "#/$defs/MemoryFile"
              }
            ]
          },
          "maxItems": 16,
          "title": "Source Refs",
          "type": "array"
        },
        "valid_from": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "command_id",
        "expected_revision_id",
        "content"
      ],
      "title": "CorrectMemory",
      "type": "object"
    },
    "FileVersionRef": {
      "additionalProperties": false,
