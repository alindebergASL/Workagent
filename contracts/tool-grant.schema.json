{
  "$defs": {
    "CapabilityPin": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
          "title": "Id",
          "type": "string"
        },
        "implementation_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Implementation Sha256",
          "type": "string"
        },
        "schema_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Schema Sha256",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "schema_sha256",
        "implementation_sha256"
      ],
      "title": "CapabilityPin",
      "type": "object"
    },
    "InputRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Kind",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "sha256"
      ],
      "title": "InputRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "access_generation": {
      "minimum": 1,
      "title": "Access Generation",
      "type": "integer"
    },
    "approval_evidence": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approval Evidence"
    },
    "budget_account_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Budget Account Id",
      "type": "string"
    },
    "capabilities": {
      "items": {
        "$ref": "#/$defs/CapabilityPin"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Capabilities",
      "type": "array"
    },
    "effects": {
      "items": {
        "enum": [
          "read",
          "local_compute",
          "draft",
          "external_write"
        ],
        "type": "string"
      },
      "maxItems": 4,
      "minItems": 1,
      "title": "Effects",
      "type": "array"
    },
    "egress": {
      "enum": [
        "none",
        "public_https"
      ],
      "title": "Egress",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Id",
      "type": "string"
    },
    "principal_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Principal Id",
      "type": "string"
    },
    "privacy_classes": {
      "items": {
        "enum": [
          "public",
          "workspace_private"
        ],
        "type": "string"
      },
      "maxItems": 2,
      "minItems": 1,
      "title": "Privacy Classes",
      "type": "array"
    },
    "resource_selectors": {
      "items": {
        "$ref": "#/$defs/InputRef"
      },
      "maxItems": 100,
      "title": "Resource Selectors",
      "type": "array"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "tool-grant/v1",
      "default": "tool-grant/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Scope Id",
      "type": "string"
    },
    "scope_kind": {
      "const": "task",
      "default": "task",
      "title": "Scope Kind",
      "type": "string"
    },
    "workspace_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "workspace_id",
    "principal_id",
    "run_id",
    "scope_id",
    "capabilities",
    "resource_selectors",
    "effects",
    "privacy_classes",
    "egress",
    "expires_at",
    "access_generation",
    "budget_account_id"
  ],
  "title": "ToolGrantV1",
  "type": "object"
}
