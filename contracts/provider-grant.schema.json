          "type": "string"
        },
        "max_steps": {
          "default": 4,
          "maximum": 8,
          "minimum": 1,
          "title": "Max Steps",
          "type": "integer"
        },
        "output_limit": {
          "maximum": 2097152,
          "minimum": 0,
          "title": "Output Limit",
