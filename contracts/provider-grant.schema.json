{
  "$defs": {
    "AdaptiveResponsesBinding": {
      "additionalProperties": false,
      "description": "Opt-in capability, not a mutation of the historical eight-generation grant.",
      "properties": {
        "authorization_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Authorization Sha256",
          "type": "string"
        },
        "cancel_limit": {
          "const": 0,
          "default": 0,
          "title": "Cancel Limit",
          "type": "integer"
        },
        "conversation_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Conversation Ids",
          "type": "array"
        },
        "cost_limit_usd": {
          "const": "20.00",
          "default": "20.00",
          "title": "Cost Limit Usd",
          "type": "string"
        },
        "count_limit": {
          "const": 50,
          "default": 50,
          "title": "Count Limit",
          "type": "integer"
        },
        "generation_limit": {
          "const": 50,
          "default": 50,
          "title": "Generation Limit",
          "type": "integer"
        },
        "input_limit": {
          "default": 2500000,
          "enum": [
            1000000,
            2500000
          ],
          "title": "Input Limit",
          "type": "integer"
        },
        "instructions_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Instructions Sha256",
          "type": "string"
        },
        "max_steps": {
          "default": 4,
          "maximum": 4,
          "minimum": 1,
          "title": "Max Steps",
          "type": "integer"
        },
        "output_limit": {
          "const": 409600,
          "default": 409600,
          "title": "Output Limit",
          "type": "integer"
        },
        "policy_version": {
          "const": "adaptive-local-v1",
          "default": "adaptive-local-v1",
          "title": "Policy Version",
          "type": "string"
        },
        "project_id": {
          "pattern": "^proj_[A-Za-z0-9_-]{1,100}$",
          "title": "Project Id",
          "type": "string"
        },
        "read_limit": {
          "const": 500,
          "default": 500,
          "title": "Read Limit",
          "type": "integer"
        },
        "schema_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Schema Sha256",
          "type": "string"
        },
        "scope_tool_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Scope Tool Sha256",
          "type": "string"
        },
        "secret_reference": {
          "pattern": "^file:/[A-Za-z0-9_./-]{1,400}$",
          "title": "Secret Reference",
          "type": "string"
        },
        "store_acknowledged": {
          "const": true,
          "default": true,
          "title": "Store Acknowledged",
          "type": "boolean"
        },
        "synthetic_data_only": {
          "const": true,
          "default": true,
          "title": "Synthetic Data Only",
          "type": "boolean"
        },
        "transport_mode": {
          "enum": [
            "synthetic",
            "official_api"
          ],
          "title": "Transport Mode",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "secret_reference",
        "transport_mode",
        "instructions_sha256",
        "schema_sha256",
        "scope_tool_sha256",
        "conversation_ids",
        "authorization_sha256"
      ],
      "title": "AdaptiveResponsesBinding",
      "type": "object"
    },
