        "schema_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Schema Sha256",
          "type": "string"
        },
        "scope_tool_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Scope Tool Sha256",
          "type": "string"
        },
        "secret_reference": {
          "pattern": "^file:/[A-Za-z0-9_./-]{1,400}$",
          "title": "Secret Reference",
          "type": "string"
        },
        "store_acknowledged": {
          "const": true,
          "default": true,
          "title": "Store Acknowledged",
          "type": "boolean"
        },
        "synthetic_data_only": {
          "const": true,
          "default": true,
          "title": "Synthetic Data Only",
          "type": "boolean"
        },
        "transport_mode": {
          "enum": [
            "synthetic",
            "official_api"
          ],
          "title": "Transport Mode",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "secret_reference",
        "transport_mode",
        "instructions_sha256",
        "schema_sha256",
        "scope_tool_sha256",
        "generation_limit",
        "count_limit",
        "read_limit",
        "input_limit",
        "output_limit",
        "cost_limit_usd",
        "conversation_ids",
        "authorization_sha256",
        "runtime_extension"
