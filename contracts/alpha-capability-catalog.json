[
  {
    "availability": "available",
    "effects": [
      "record_local_responsibility"
    ],
    "handler": "responsibility",
    "input_schema": {
      "$defs": {
        "RecordingPlan": {
          "additionalProperties": false,
          "properties": {
            "current_outcome": {
              "maxLength": 10000,
              "minLength": 1,
              "title": "Current Outcome",
              "type": "string"
            },
            "dependencies": {
              "items": {
                "$ref": "#/$defs/ResponsibilityDependency"
              },
              "maxItems": 50,
              "title": "Dependencies",
              "type": "array"
            },
            "next_action": {
              "$ref": "#/$defs/ResponsibilityNextAction"
            },
            "next_check_in_at": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Next Check In At"
            },
            "wait": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ResponsibilityWait"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "current_outcome",
            "next_action",
            "dependencies",
            "wait",
            "next_check_in_at"
          ],
          "title": "RecordingPlan",
          "type": "object"
        },
        "ResponsibilityDependency": {
          "additionalProperties": false,
          "properties": {
            "expected_version": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "title": "Expected Version",
              "type": "string"
            },
            "kind": {
              "enum": [
                "artifact_revision",
                "source_version"
              ],
              "title": "Kind",
              "type": "string"
            },
            "object_id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "title": "Object Id",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "object_id",
            "expected_version"
          ],
          "title": "ResponsibilityDependency",
          "type": "object"
        },
        "ResponsibilityNextAction": {
          "additionalProperties": false,
          "properties": {
            "description": {
              "maxLength": 10000,
              "minLength": 1,
              "title": "Description",
              "type": "string"
            },
            "kind": {
              "enum": [
                "continue_work",
                "review_dependency",
                "request_decision",
                "await_event",
                "obtain_grant",
                "obtain_tool"
              ],
              "title": "Kind",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "description"
          ],
          "title": "ResponsibilityNextAction",
          "type": "object"
        },
        "ResponsibilityWait": {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "person",
                "dependency_change",
                "check_in"
              ],
              "title": "Kind",
              "type": "string"
            },
            "reason": {
              "maxLength": 10000,
              "minLength": 1,
              "title": "Reason",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "title": "ResponsibilityWait",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "completion_criteria": {
          "items": {
            "maxLength": 10000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Completion Criteria",
          "type": "array"
        },
        "goal": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Goal",
          "type": "string"
        },
        "kind": {
          "const": "record_responsibility",
          "title": "Kind",
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/RecordingPlan"
        }
      },
      "required": [
        "kind",
        "goal",
        "completion_criteria",
        "plan"
      ],
      "title": "RecordResponsibility",
      "type": "object"
    },
    "name": "record_responsibility",
    "reason": "No external monitoring, actions, completion or execution grant.",
    "scope": "Current human request and exact offered local dependencies",
    "version": "1"
  },
